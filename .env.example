# Copied to .env automatically by `npm run dev` (scripts/ensure-env.mjs).
# .env is gitignored; this file is the committed template. No real credentials here.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# How the API reaches MySQL (from the host, via the published port below).
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=habitlog
DB_PASSWORD=habitlog
DB_NAME=habitlog

# How Docker Compose bootstraps the MySQL container.
MYSQL_ROOT_PASSWORD=rootpw
MYSQL_DATABASE=habitlog
MYSQL_USER=habitlog
MYSQL_PASSWORD=habitlog
MYSQL_PORT=3307
